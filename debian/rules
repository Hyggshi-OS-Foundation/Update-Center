#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake --parallel

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_test:
	@echo "No test suite configured."

# Substitute Qt6 package names with OR-alternatives (e.g. libqt6gui6 | libqt6gui6t64)
# so the package can be installed on both Ubuntu Noble (t64) and Debian/other Ubuntu versions.
override_dh_shlibdeps:
	dh_shlibdeps
	sed -i -E 's/(libqt6[a-z0-9]+6)t64/\1 | \1t64/g' debian/updatecenter.substvars
	sed -i -E 's/(libqt6[a-z0-9]+6)([^|t64]|$)/\1 | \1t64\2/g' debian/updatecenter.substvars


