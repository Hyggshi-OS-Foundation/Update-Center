/* ============================================================
   Update Center — dark theme
   Palette: near-black sidebar (#12141C), dark content (#181B24),
   accent blue (#5B8DFF), cards dark grey (#1E212B) with soft shadow.
   Same object names as style.qss so both themes can be hot-swapped.
   ============================================================ */

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #E4E7EE;
}

QMainWindow, QWidget#pageOverview, QWidget#pageUpdates,
QWidget#pageHistory, QWidget#pageSettings {
    background: #181B24;
}

/* ---------------- Sidebar ---------------- */
QWidget#sidebar {
    background: #12141C;
}

QWidget#sidebarHeader {
    background: #0E0F16;
    border-bottom: 1px solid #232734;
}

QLabel#sidebarLogo {
    color: #5B8DFF;
    font-size: 20px;
    font-weight: 600;
}

QLabel#sidebarTitle {
    color: #F5F7FB;
    font-size: 15px;
    font-weight: 600;
    padding-left: 8px;
}

QListWidget#navList {
    background: transparent;
    border: none;
    outline: none;
    padding: 10px 0px;
}

QListWidget#navList::item {
    color: #7C8598;
    padding-left: 14px;
    border: none;
    border-left: 3px solid transparent;
}

QListWidget#navList::item:hover {
    background: #1C2130;
    color: #E7ECF5;
}

QListWidget#navList::item:selected {
    background: #1C2130;
    color: #FFFFFF;
    border-left: 3px solid #5B8DFF;
    font-weight: 600;
}

/* ---------------- Headings ---------------- */
QLabel#pageHeading {
    font-size: 22px;
    font-weight: 700;
    color: #F5F7FB;
}

QLabel#pageSubtitle {
    font-size: 13px;
    color: #8890A3;
    margin-bottom: 6px;
}

QLabel#mutedLabel {
    color: #8890A3;
}

QLabel#infoValue {
    font-size: 15px;
    font-weight: 600;
    color: #F5F7FB;
}

QLabel#emptyTitle {
    font-size: 15px;
    font-weight: 600;
    color: #C7CCDA;
}

QLabel#pkgNameLabel {
    font-weight: 500;
    color: #E4E7EE;
}

/* ---------------- Cards ---------------- */
QFrame#card {
    background: #1E212B;
    border-radius: 12px;
    border: 1px solid #2A2E3A;
}

/* ---------------- Dialogs ---------------- */
QDialog {
    background: #181B24;
}

/* ---------------- Status icon ---------------- */
QLabel#statusIcon {
    background: #16321F;
    color: #3FCB7C;
    border-radius: 28px;
    font-size: 22px;
    font-weight: 700;
}
QLabel#statusIcon[state="warn"] {
    background: #3A2A12;
    color: #E5A03D;
}
QLabel#statusIcon[state="checking"] {
    background: #1A2440;
    color: #5B8DFF;
}

QLabel#statusText {
    font-size: 15px;
    font-weight: 600;
    color: #F5F7FB;
}

/* ---------------- Buttons ---------------- */
QPushButton#primaryButton {
    background: #5B8DFF;
    color: #0E0F16;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background: #7BA3FF; }
QPushButton#primaryButton:pressed { background: #4272E0; }
QPushButton#primaryButton:disabled { background: #33415F; color: #7C8598; }

QPushButton#secondaryButton {
    background: #1E212B;
    color: #E4E7EE;
    border: 1px solid #333849;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
}
QPushButton#secondaryButton:hover { background: #262B38; }
QPushButton#secondaryButton:disabled { color: #5B6274; }

/* ---------------- Progress bar ---------------- */
QProgressBar#checkProgress {
    background: #2A2E3A;
    border: none;
    border-radius: 3px;
}
QProgressBar#checkProgress::chunk {
    background: #5B8DFF;
    border-radius: 3px;
}

/* ---------------- Tables ---------------- */
QTableWidget#updatesTable {
    background: transparent;
    border: none;
    gridline-color: transparent;
    selection-background-color: transparent;
}
QTableWidget#updatesTable::item {
    padding: 6px 10px;
    border-bottom: 1px solid #262A36;
}
QTreeWidget#historyTable {
    background: transparent;
    border: none;
}
QTreeWidget#historyTable::item {
    padding: 6px 10px;
    border-bottom: 1px solid #262A36;
}
QHeaderView::section {
    background: #1A1D26;
    color: #8890A3;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #2A2E3A;
    padding: 10px;
}

/* ---------------- Repository sources list ---------------- */
QListWidget#repoList {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#repoList::item {
    border-bottom: 1px solid #262A36;
}
QListWidget#repoList::item:last {
    border-bottom: none;
}

/* ---------------- Inputs ---------------- */
QComboBox {
    background: #1E212B;
    color: #E4E7EE;
    border: 1px solid #333849;
    border-radius: 6px;
    padding: 6px 10px;
    min-width: 160px;
}
QComboBox:hover { border-color: #5B8DFF; }
QComboBox::drop-down { border: none; width: 24px; }

QLineEdit {
    background: #1E212B;
    color: #E4E7EE;
    border: 1px solid #333849;
    border-radius: 6px;
    padding: 8px 10px;
}
QLineEdit:focus { border: 1px solid #5B8DFF; }
QLineEdit[error="true"] { border: 1px solid #E0527A; background: #2A1A20; }

QCheckBox {
    spacing: 8px;
    padding: 2px 0;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #454C5F;
    background: #1E212B;
}
QCheckBox::indicator:checked {
    background: #5B8DFF;
    border-color: #5B8DFF;
}

/* ---------------- Scrollbars ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #333849;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #454C5F; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
